# ── Monitored Elasticsearch (the cluster the gateway proxies) ───────────
# ALO never writes here. Docker Compose does NOT run Elasticsearch — point
# this at your own cluster.

ELASTICSEARCH_HOST=elasticsearch:9200

# ── Container-to-container wiring (Docker Compose / Helm) ───────────────
# Set in docker-compose.yml with container-hostname defaults.
# Override when deploying to non-Docker environments.

ANALYZER_URL=http://analyzer:8000/analyze
LOGSTASH_URL=http://logstash:8080/
LOGSTASH_HTTP_PORT=8080
GATEWAY_PORT=9200
GRAFANA_PORT=3000
DNS_RESOLVER=127.0.0.11
# Tenant key stamped on every record and on Prometheus series. Keep the
# gateway, logstash, and prometheus values identical.
CLUSTER_NAME=default

# ── ClickHouse (the analytics sink) ─────────────────────────────────────
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=alo
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# CLICKHOUSE_HTTP_PORT=8123      # host port mapping (compose only)
# CLICKHOUSE_TCP_PORT=9000       # host port mapping (compose only)
# CLICKHOUSE_CA_CERT=            # path to a CA bundle for TLS
# CLICKHOUSE_INSECURE=false      # skip TLS verification
# CLICKHOUSE_CLUSTER=            # non-empty enables ON CLUSTER + Distributed tables

# ── Gateway ─────────────────────────────────────────────────────────────
# WORKER_CONNECTIONS=1024        # connections per nginx worker
# CLIENT_BODY_BUFFER_SIZE=64m    # larger request bodies spool to disk
# LOGSTASH_TIMEOUT_MS=1000       # async notification timeout to Logstash

# ── Logstash ────────────────────────────────────────────────────────────
# LS_JAVA_OPTS=-Xms512m -Xmx512m
# LS_CH_FLUSH_SIZE=5000              # rows per ClickHouse insert (alo_raw)
# LS_CH_DEAD_LETTER_FLUSH_SIZE=1000  # rows per insert (alo_dead_letter)
# LS_CH_IDLE_FLUSH_TIME=5            # seconds before flushing a partial batch
# LS_CH_AUTOMATIC_RETRIES=3
# LS_CH_POOL_MAX=10
# LS_CH_SETTINGS=input_format_skip_unknown_fields=1,async_insert=1,wait_for_async_insert=0

# ── Analyzer: request body capture ──────────────────────────────────────
# Max bytes of request_body persisted to ClickHouse (0 = no truncation).
# Analysis always runs on the full body; only the stored copy is capped.
# ALO_REQUEST_BODY_STORE_MAX_BYTES=32768

# ── Analyzer: stress baselines ──────────────────────────────────────────
# Static values. Any key set here wins over the dynamic refresh below.
# STRESS_BASELINE_TOOK_MS=100
# STRESS_BASELINE_HITS=500
# STRESS_BASELINE_SHARDS_TOTAL=5
# STRESS_BASELINE_DOCS_AFFECTED=500

# ── Analyzer: dynamic baselines (P50 from recent ClickHouse traffic) ─────
# BASELINE_CACHE_TTL=60          # seconds between refreshes
# BASELINE_QUERY_WINDOW=1 HOUR   # ClickHouse interval syntax

# ── Analyzer: cost indicator thresholds ─────────────────────────────────
# COST_INDICATOR_BOOL_THRESHOLD=50
# COST_INDICATOR_TERMS_THRESHOLD=500
# COST_INDICATOR_AGGS_THRESHOLD=10

# ── Analyzer: stress bonus tuning ───────────────────────────────────────
# STRESS_CLAUSE_THRESHOLD=4
# STRESS_CLAUSE_WEIGHT=0.10
# STRESS_CLAUSE_CAP=0.50
# STRESS_AGG_THRESHOLD=3
# STRESS_AGG_WEIGHT=0.10
# STRESS_AGG_CAP=0.50
# STRESS_GEO_VERTEX_THRESHOLD=10

# ── Grafana ─────────────────────────────────────────────────────────────
# GRAFANA_ADMIN_PASSWORD=admin
# PROMETHEUS_URL=http://prometheus:9090   # set before running grafana/setup.py
#                                         # to provision a Prometheus datasource

# ── Host-side scripts (stress.py, integration tests, challenges) ────────
# These default to localhost when unset, which is correct for local dev.
# GATEWAY_URL=http://localhost:9200
# DIRECT_ES_URL=http://localhost:9201
# GRAFANA_URL=http://localhost:3000
# ES_USERNAME=
# ES_PASSWORD=
# ES_CA_CERT=
# ES_INSECURE=false
